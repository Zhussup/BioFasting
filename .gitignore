# Local design assets, intentionally not committed
misc/*
# Keep only the assets the README references (banner + the charts)
!misc/biofasting.gif
!misc/why-this-exists.png
!misc/g1-ranking.png
!misc/profile-share.png

# Generated benchmark corpora -- large, and regenerable from one command:
#   python3 bench/gen_data.py
# MANIFEST.json inside them carries a SHA-256 per artifact.
bench/data/
bench/data-quick/

# Benchmark results are machine-specific; re-derive them with bench/run.py.
# The durable artifact is bench/targets.md (step 0.5).
bench/results/

# Local benchmark virtualenv (see bench/requirements.txt)
.venv/

# Build artifacts of the C++ core.  Never commit a compiled extension: it is
# architecture- and interpreter-specific, and it hides a broken build by making
# the import succeed on the machine that produced it.
build/
dist/
wheelhouse/
_skbuild/
*.so
*.pyd
*.egg-info/

__pycache__/
*.py[cod]
.pytest_cache/